# All default inputs are synthetic. This file is documentation; export values or use Docker --env-file.
RISK_DB_PATH=risk.sqlite3
# 0 = request-driven. Enable periodic assessment + recommendation with e.g. 120.
RISK_POLL_SECONDS=0
# Optional JSON policy path; see policy.example.json. Restart after policy changes.
# RISK_CONFIG_PATH=policy.example.json
ISSUER_PROVIDER=mock
# Optional live LLM extraction of supplied documents. Market/oracle providers remain simulated.
# ISSUER_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-approved-provider.example/v1
# LLM_MODEL=your-model
# LLM_API_KEY=
