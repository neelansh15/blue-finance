# Render service secrets. The keeper account needs BNB; the signer account signs off-chain.
BLUE_BSC_RPC_URL=https://bsc-rpc.publicnode.com
BLUE_KEEPER_PRIVATE_KEY=
BLUE_SIGNER_PRIVATE_KEY=
# Random shared secret, at least 32 characters. Also set it as a server-only frontend variable.
BLUE_ELIGIBILITY_API_TOKEN=
# Comma-separated BNB Chain borrower addresses.
BLUE_ELIGIBLE_ACCOUNTS=0xf475D99Be3241c69454eA8AF7B12F38078F697bc
# Optional comma-separated list. Omit for all deployed stocks.
# BLUE_KEEPER_MARKETS=TSLAB
