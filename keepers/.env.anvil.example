# Example for the local anvil fork. The real file is generated by demo/start.sh (addresses are deterministic). Load with bash `set -a; source .env.anvil`, NOT --env-file (JSON values). Keys are public anvil keys.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=56
REGIME_REGISTRY=0x<ADDRESS>
ASSETS='[{"symbol":"bAAPL","ticker":"AAPL","token":"0x<ADDRESS>","feed":"0x<ADDRESS>","oracle":"0x<ADDRESS>"}]'
KEEPER_PRIVATE_KEY=0x<anvil key, see demo/config.env>
DRY_RUN=false
POLL_INTERVAL_MS=5000
OVERRIDE_DURATION_S=3600
CONTINUITY_BAND_BPS=500
MORPHO=0x<ADDRESS>
MARKET_ID=0x<ADDRESS>6488f46614ab2d48799dd1d3
MARKET_PARAMS='{"loanToken":"0x<ADDRESS>","collateralToken":"0x<ADDRESS>","oracle":"0x<ADDRESS>","irm":"0x<ADDRESS>","lltv":"625000000000000000"}'
LIQUIDATOR=0x<ADDRESS>
LIQUIDATOR_PRIVATE_KEY=0x<anvil key, see demo/config.env>
FROM_BLOCK=<block after the fork block, written by demo/start.sh>
LOG_CHUNK=2000
