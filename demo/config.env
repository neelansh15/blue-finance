# Blue demo: ALL tunables live here. Every value is a labelled PLACEHOLDER; the owner will adjust.
# Contract risk parameters (haircuts, LLTV, margin, caps, staleness) are constants in
# protocol/script/BlueDeploy.sol (not editable from here without touching protocol/script).

# --- chain / fork ---
export PATH=/workspace/agent/work/foundry/bin:$PATH
FORK_URL="${BSC_RPC_URL:-https://bsc-mainnet.public.blastapi.io}"   # upstream BSC RPC; MUST be archive-capable (bsc-dataseed.binance.org prunes state after ~minutes and breaks the fork)
ANVIL_PORT=8545                                               # fixed
RPC_URL="http://127.0.0.1:${ANVIL_PORT}"
CHAIN_ID=56                                                   # anvil fork keeps chain id 56

# --- deploy (read by protocol/script/Deploy.s.sol) ---
# PLACEHOLDER: anvil account 0 and 1, PUBLIC test keys. Never use on a real chain.
DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
KEEPER_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
LIQUIDATOR_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
USER_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
SEED_SUPPLY=100000000000000000000000        # PLACEHOLDER 100,000 USDT supplied by deployer
INITIAL_PRICE=20000000000                   # PLACEHOLDER 200.00 USD per share, 8 decimals

# --- demo user ---
USER_COLLATERAL_WEI=50000000000000000000    # PLACEHOLDER 50 bAAPL minted to the demo user
USER_USDT_WEI=20000000000000000000000       # PLACEHOLDER 20,000 USDT given to user (for repay/gas of scenarios)
LIQ_USDT_WEI=50000000000000000000000        # PLACEHOLDER 50,000 USDT for the liquidation bot
FRONTEND_BORROW_USD=3600                    # PLACEHOLDER suggested demo borrow
# Demo eligibility signer key is the PUBLIC constant keccak256("blue.demo.eligibility.signer").

# --- keepers / demo control ---
OVERRIDE_DURATION_S=3600                    # PLACEHOLDER
WEEKEND_DURATION_S=600                      # PLACEHOLDER demo override length
SPLIT_MULTIPLIER_WAD=2000000000000000000    # PLACEHOLDER 2-for-1: uiMultiplier 2.0
GAP_FRACTION=-0.35                          # PLACEHOLDER price gap for the liquidation scenario
POLL_INTERVAL_MS=5000                       # PLACEHOLDER keeper loop period on the demo
CONTINUITY_BAND_BPS=500                     # must equal the oracle's (BlueDeploy.sol)
FRONTEND_PORT=3000
export NODE_NO_WARNINGS=1
export NO_PROXY="127.0.0.1,localhost${NO_PROXY:+,$NO_PROXY}" no_proxy="127.0.0.1,localhost${no_proxy:+,$no_proxy}"   # sandbox HTTP proxy must not catch anvil

# Chain clock for the demo (PLACEHOLDER). Anvil is warped here after deploy so the calendar regime is OPEN
# (a Tuesday, 10:00 New York, no US holiday) regardless of when you run the demo. Set WARP_TO= (empty) to keep real time.
export WARP_TO="${WARP_TO-1796137200}"
# Scenario 3/4 inputs (PLACEHOLDERS). SPLIT_MULTIPLIER_WAD_HUMAN is the same value as SPLIT_MULTIPLIER_WAD, human units.
export SPLIT_MULTIPLIER_WAD_HUMAN="${SPLIT_MULTIPLIER_WAD_HUMAN-2}"
export GAP_PRICE="${GAP_PRICE-130}"   # USD per share after the gap (200 -> 130 = -35%)
# Position used by demo/check.sh and the README script (PLACEHOLDERS): 10 bAAPL at $200 = $2000; limit OPEN ~1022, WEEKEND ~869.
export CHECK_COLLATERAL="${CHECK_COLLATERAL-10}"
export CHECK_BORROW="${CHECK_BORROW-1000}"
