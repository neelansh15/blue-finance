# Server-only backend address. Never use NEXT_PUBLIC_ for backend credentials.
RISK_API_URL=http://127.0.0.1:8000
# Optional public project identifier for WalletConnect QR/mobile linking.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional read-only verification of a concrete Blue deployment. Public metadata only.
NEXT_PUBLIC_BLUE_RPC_URL=
# JSON: chainId,router,morpho,registry,loanToken,collateralToken,oracle,irm,lltv (decimal string).
NEXT_PUBLIC_BLUE_MARKET_IDENTITY=
