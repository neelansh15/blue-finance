# Server-only backend address. Never use NEXT_PUBLIC_ for backend credentials.
RISK_API_URL=http://127.0.0.1:8000
# Optional public project identifier for WalletConnect QR/mobile linking.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional browser-accessible BNB Smart Chain mainnet RPC (public, no credentials).
NEXT_PUBLIC_BSC_RPC_URL=
# The app uses the demo pool (test tokens). Set to real for the live pool.
NEXT_PUBLIC_BLUE_DEPLOYMENT=
# Server-only. HTTPS origin of the keeper/eligibility service (keepers/src/v3) and its shared secret.
BLUE_ELIGIBILITY_URL=
BLUE_ELIGIBILITY_API_TOKEN=
